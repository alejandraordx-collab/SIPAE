<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIPAE — Iniciar sesión</title>
    <meta name="description" content="Sistema de información para la prevención de la deserción escolar, registro de asistencia y control del PAE en el Colegio OEA.">
    <style>
        /* ---- Reset y base ---- */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #fdf5f4;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        body::before {
            content: "";
            position: fixed;
            top: 50%;
            left: 50%;
            width: 560px;
            height: 560px;
            transform: translate(-50%, -50%);
            background: url('/img/marca_agua.png') no-repeat center center;
            background-size: contain;
            opacity: .05;
            pointer-events: none;
            z-index: -1;
        }

        /* ---- Tarjeta principal ---- */
        .card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, .10);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 420px;
            margin: 1.5rem;
        }

        /* ---- Encabezado / logo ---- */
        .card__header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .card__logo {
            width: 110px;
            height: 110px;
            border-radius: 16px;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .75rem;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .10);
            background: #fff;
        }

        .card__logo img { width: 100%; height: 100%; object-fit: contain; display: block; }

        .card__title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1e2a3a;
        }

        .card__subtitle {
            font-size: .85rem;
            color: #6b7280;
            margin-top: .25rem;
        }

        /* ---- Alerta de error ---- */
        .alert {
            background: #fef2f2;
            border: 1px solid #fca5a5;
            color: #b91c1c;
            border-radius: 8px;
            padding: .75rem 1rem;
            font-size: .875rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .alert svg { flex-shrink: 0; width: 18px; height: 18px; fill: #b91c1c; }

        .alert--info {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1d4ed8;
        }

        /* ---- Formulario ---- */
        .form__group { margin-bottom: 1.25rem; }

        .form__label {
            display: block;
            font-size: .875rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: .375rem;
        }

        .form__input {
            width: 100%;
            padding: .625rem .875rem;
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            font-size: .95rem;
            color: #1e2a3a;
            transition: border-color .2s, box-shadow .2s;
            outline: none;
        }

        .form__input:focus {
            border-color: #ee7374;
            box-shadow: 0 0 0 3px rgba(238, 115, 116, .15);
        }

        /* ---- Botón de submit ---- */
        .btn-primary {
            width: 100%;
            padding: .75rem;
            background: #ee7374;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s, transform .1s;
            margin-top: .5rem;
        }

        .btn-primary:hover  { background: #ca6263; }
        .btn-primary:active { transform: scale(.98); }

        .demo-credentials {
            margin-top: 1.5rem;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            padding: .75rem;
            font-size: .75rem;
            color: #475569;
        }

        .demo-credentials strong { color: #1e293b; }
        .demo-credentials code { background: #e2e8f0; padding: .1rem .3rem; border-radius: 4px; font-family: monospace; }
        .demo-badge { display: inline-block; padding: .15rem .45rem; border-radius: 4px; font-weight: 600; font-size: .7rem; margin-right: .3rem; cursor: pointer; background: #e2e8f0; }
        .demo-badge:hover { background: #cbd5e1; }

        /* ---- Pie de tarjeta ---- */
        .card__footer {
            text-align: center;
            margin-top: 1.5rem;
            font-size: .8rem;
            color: #9ca3af;
        }
    </style>
</head>
<body>

<main class="card" role="main">

    <!-- Encabezado -->
    <header class="card__header">
        <div class="card__logo">
            <img src="/img/logo.jpg" alt="Logo de SIPAE - Colegio OEA">
        </div>
        <h1 class="card__title">SIPAE</h1>
        <p class="card__subtitle">Colegio OEA — Inicio de sesión</p>
    </header>

    <!-- Mensaje de error (dinámico o del servidor) -->
    <div id="alert-box" class="alert" role="alert" style="<%= error ? '' : 'display:none;' %>">
        <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill-rule="evenodd" d="M18 10A8 8 0 11 2 10a8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
        </svg>
        <span id="alert-msg"><%= error || '' %></span>
    </div>

    <% if (typeof mensajeExito !== 'undefined' && mensajeExito) { %>
        <div class="alert alert--info" role="alert">
            <%= mensajeExito %>
        </div>
    <% } %>

    <!-- Formulario de login -->
    <form id="login-form" method="post" action="/login" novalidate>
        <input type="hidden" name="ajax" value="1">
        <input type="hidden" id="auth-field" name="auth" value="">

        <div class="form__group">
            <label class="form__label" for="correo">Correo institucional o usuario</label>
            <input
                class="form__input"
                type="text"
                id="correo"
                name="correo"
                placeholder="usuario@oea.edu.co"
                required
                maxlength="150"
                autocomplete="username"
                value="<%= correo || '' %>"
            >
        </div>

        <div class="form__group">
            <label class="form__label" for="contrasena">Contraseña</label>
            <input
                class="form__input"
                type="password"
                id="contrasena"
                name="contrasena"
                placeholder="••••••••"
                required
                maxlength="128"
                autocomplete="current-password"
            >
        </div>

        <button id="btn-submit" class="btn-primary" type="submit">Ingresar al sistema</button>

        <div style="margin-top: 1rem; text-align: center;">
            <a href="/recuperar_contrasena" style="font-size: .85rem; color: #ee7374; text-decoration: none; font-weight: 600;">
                ¿Olvidaste tu contraseña?
            </a>
        </div>

    </form>

    <div class="demo-credentials">
        <strong>Acceso de prueba rápido:</strong> (Contraseña: <code>Test1234!</code>)<br>
        <div style="margin-top:.4rem;display:flex;gap:.5rem;flex-wrap:wrap;">
            <button type="button" class="demo-badge" onclick="loginDirecto('laura.martinez@oea.edu.co', 'Test1234!')">👤 Coordinador (Laura)</button>
            <button type="button" class="demo-badge" onclick="loginDirecto('carlos.herrera@oea.edu.co', 'Test1234!')">👤 Docente (Carlos)</button>
        </div>
    </div>

    <footer class="card__footer">
        <p>SIPAE &copy; <%= new Date().getFullYear() %> — Colegio OEA</p>
    </footer>

</main>

<script>
(function() {
    'use strict';

    const form = document.getElementById('login-form');
    const alertBox = document.getElementById('alert-box');
    const alertMsg = document.getElementById('alert-msg');
    const btnSubmit = document.getElementById('btn-submit');

    function showError(msg) {
        alertMsg.textContent = msg;
        alertBox.style.display = 'flex';
        btnSubmit.disabled = false;
        btnSubmit.textContent = 'Ingresar al sistema';
    }

    // Auto-verify if already logged in via token
    const savedToken = localStorage.getItem('sipae_auth');
    if (savedToken && !window.location.search.includes('logout')) {
        fetch('/api/verify_session?auth=' + encodeURIComponent(savedToken))
            .then(r => r.json())
            .then(data => {
                if (data.ok && data.redirect) {
                    window.location.href = data.redirect;
                }
            })
            .catch(() => {});
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        const correo = document.getElementById('correo').value.trim();
        const contrasena = document.getElementById('contrasena').value.trim();

        if (!correo || !contrasena) {
            showError('Por favor completa todos los campos.');
            return;
        }

        btnSubmit.disabled = true;
        btnSubmit.textContent = 'Verificando…';

        fetch('/login', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ correo: correo, contrasena: contrasena })
        })
        .then(function(res) {
            return res.json().then(function(data) {
                return { status: res.status, ok: res.ok, data: data };
            });
        })
        .then(function(res) {
            if (res.ok && res.data.ok) {
                if (res.data.token) {
                    localStorage.setItem('sipae_auth', res.data.token);
                }
                btnSubmit.textContent = 'Ingresando…';
                window.location.href = res.data.redirect || '/';
            } else {
                showError(res.data.error || 'Correo o contraseña incorrectos.');
            }
        })
        .catch(function(err) {
            // Fallback to normal form submit
            console.warn('Fallback standard submit:', err);
            form.submit();
        });
    });

    window.loginDirecto = function(email, pass) {
        document.getElementById('correo').value = email;
        document.getElementById('contrasena').value = pass;
        form.dispatchEvent(new Event('submit'));
    };

    window.fillCreds = function(email, pass) {
        document.getElementById('correo').value = email;
        document.getElementById('contrasena').value = pass;
    };
})();
</script>

</body>
</html>
